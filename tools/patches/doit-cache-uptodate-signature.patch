+UPTODATE_ARGS = {}
+
+
+def uptodate_args(utd):
+    """return the parameter names of an uptodate callable
+
+    Names are cached by code for functions and by class for callable objects.
+    """
+    if hasattr(utd, '__wrapped__') or hasattr(utd, '__signature__'):
+        return list(inspect.signature(utd).parameters.keys())
+    if inspect.isfunction(utd):
+        key = utd.__code__
+    elif inspect.isfunction(getattr(type(utd), '__call__', None)):
+        key = type(utd)
+    else:
+        return list(inspect.signature(utd).parameters.keys())
+    try:
+        return UPTODATE_ARGS[key]
+    except KeyError:
+        args = list(inspect.signature(utd).parameters.keys())
+        UPTODATE_ARGS[key] = args
+        return args
+
