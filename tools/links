#!/usr/bin/env nix
# -*- python -*-
#! nix shell ..#tools.links --command python3
"""Check and fix links of the website.

Usage: links check [--local]
       links fix
"""

import argparse
import contextlib
import dataclasses
import datetime
import json
import os
import re
import sqlite3
import subprocess
import sys
import urllib.request
import xml.etree.ElementTree as ET
from collections.abc import Callable
from pathlib import Path
from typing import Any, ClassVar

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import VerticalScroll
from textual.screen import ModalScreen
from textual.widgets import DataTable, Footer, Input, Static

ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
)
BASE = "https://vincent.bernat.ch"
DIRECTORY = ROOT / ".cache" / "links"
INPUTS = DIRECTORY / "inputs.txt"
OUTPUT = DIRECTORY / "lychee.json"
DATABASE = DIRECTORY / "links.db"

# Redirects not worth a fix
REDIRECT_EXCEPTIONS = [
    "https://encrypted.google.com",
    "https://youtu.be",
    "https://zsh.sourceforge.net",
]


def fetch(url: str) -> bytes:
    with urllib.request.urlopen(url, timeout=30) as response:
        data: bytes = response.read()
    return data


def pages(base: str) -> list[str]:
    """List the pages of the site from the sitemaps in robots.txt."""
    robots = fetch(f"{base}/robots.txt").decode()
    sitemaps = re.findall(r"^Sitemap:\s*(\S+)", robots, re.MULTILINE | re.IGNORECASE)
    ns = {"s": "http://www.sitemaps.org/schemas/sitemap/0.9"}
    result = []
    for sitemap in sitemaps:
        tree = ET.fromstring(fetch(sitemap.replace(BASE, base, 1)))
        for loc in tree.iterfind("s:url/s:loc", ns):
            result.append((loc.text or "").strip().replace(BASE, base, 1))
    return result


def database() -> sqlite3.Connection:
    """Open the database of dead and redirected links."""
    DIRECTORY.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DATABASE)
    db.execute("""
CREATE TABLE IF NOT EXISTS links (
  url TEXT PRIMARY KEY,
  code INTEGER,
  status TEXT NOT NULL,
  redirect TEXT,
  first_seen TEXT,
  count INTEGER NOT NULL DEFAULT 0,
  last_seen TEXT,
  ignored TEXT
)""")
    db.execute("""
CREATE TABLE IF NOT EXISTS sources (
  url TEXT NOT NULL REFERENCES links (url) ON DELETE CASCADE,
  page TEXT NOT NULL,
  PRIMARY KEY (url, page)
)""")
    db.execute("PRAGMA foreign_keys = ON")
    return db


def redirect(entry: dict[str, Any]) -> str | None:
    """Target of a permanent redirect worth a fix."""
    hops = (entry.get("redirects") or {}).get("redirects") or []
    if not hops or any(hop["code"] not in (301, 308) for hop in hops):
        return None
    origin, target = entry["url"], hops[-1]["url"]
    if target.startswith(origin):
        return None
    if any(origin.startswith(exception) for exception in REDIRECT_EXCEPTIONS):
        return None
    return str(target)


def record(report: dict[str, Any]) -> None:
    """Record dead and redirected links from a lychee report."""
    today = datetime.datetime.now(datetime.UTC).date().isoformat()
    sources: dict[str, set[str]] = {}
    errors: dict[str, tuple[int | None, str]] = {}
    redirects: dict[str, tuple[int, str]] = {}
    cached: set[str] = set()
    for name in ("success_map", "error_map", "timeout_map"):
        for page, entries in report[name].items():
            for entry in entries:
                url = entry["url"]
                sources.setdefault(url, set()).add(page)
                status = entry["status"]
                if name == "error_map":
                    errors[url] = (
                        status.get("code"),
                        status.get("details") or status["text"],
                    )
                elif name == "success_map":
                    if "(cached)" in status["text"]:
                        cached.add(url)
                    elif target := redirect(entry):
                        code = entry["redirects"]["redirects"][0]["code"]
                        redirects[url] = (code, target)
    with contextlib.closing(database()) as db, db:
        # A link missing from the report is gone from the content. A cached
        # link has no redirect information: keep what we know. A timeout
        # tells nothing.
        keep = set(errors) | set(redirects) | set(report["timeout_map"]) | cached
        db.execute(
            "DELETE FROM links WHERE url NOT IN (SELECT value FROM json_each(?))",
            (json.dumps(list(keep)),),
        )
        db.execute(
            "DELETE FROM links WHERE redirect IS NULL "
            "AND url IN (SELECT value FROM json_each(?))",
            (json.dumps(list(cached)),),
        )
        for url, (code, status) in errors.items():
            # Checking twice the same day should not count twice.
            db.execute(
                "INSERT INTO links (url, code, status, first_seen, last_seen, count) "
                "VALUES (?, ?, ?, ?, ?, 1) "
                "ON CONFLICT (url) DO UPDATE SET "
                "  ignored = iif(links.code IS excluded.code "
                "    AND links.status = excluded.status, links.ignored, NULL), "
                "  code = excluded.code, "
                "  status = excluded.status, "
                "  redirect = NULL, "
                "  first_seen = coalesce(links.first_seen, excluded.first_seen), "
                "  last_seen = excluded.last_seen, "
                "  count = links.count + (links.last_seen IS NOT excluded.last_seen)",
                (url, code, status, today, today),
            )
        for url, (code, target) in redirects.items():
            db.execute(
                "INSERT INTO links (url, code, status, redirect) "
                "VALUES (?, ?, 'redirect', ?) "
                "ON CONFLICT (url) DO UPDATE SET "
                "  ignored = iif(links.redirect IS excluded.redirect, "
                "    links.ignored, NULL), "
                "  code = excluded.code, "
                "  status = excluded.status, "
                "  redirect = excluded.redirect, "
                "  first_seen = NULL, last_seen = NULL, count = 0",
                (url, code, target),
            )
        for url, urls in sources.items():
            db.execute("DELETE FROM sources WHERE url = ?", (url,))
            db.executemany(
                "INSERT INTO sources (url, page) "
                "SELECT ?, ? WHERE EXISTS (SELECT 1 FROM links WHERE url = ?)",
                [(url, page, url) for page in sorted(urls)],
            )


@dataclasses.dataclass
class Problem:
    url: str
    code: int | None
    status: str
    redirect: str | None
    first_seen: str | None
    count: int
    pages: list[str]

    @property
    def history(self) -> str | None:
        if self.first_seen is None:
            return None
        times = "once" if self.count == 1 else f"{self.count} times"
        return f"dead since {self.first_seen}, {times}"

    @property
    def archive(self) -> str:
        return f"https://web.archive.org/web/{self.year}/{self.url}"

    @property
    def year(self) -> int:
        """Year the link was added, guessed from the pages using it."""
        years = [
            int(mo.group(1))
            for page in self.pages
            if (mo := re.search(r"/blog/(\d{4})-", page))
        ]
        return min(years, default=datetime.datetime.now(datetime.UTC).year)


def problems() -> list[Problem]:
    with contextlib.closing(database()) as db:
        rows = db.execute("""
SELECT url, code, status, redirect, first_seen, count,
       (SELECT json_group_array(page) FROM sources WHERE sources.url = links.url)
FROM links
WHERE ignored IS NULL OR ignored < date('now', '-6 months')
ORDER BY redirect IS NOT NULL, first_seen, url""").fetchall()
    return [
        Problem(url, code, status, redirect, first_seen, count, json.loads(pages))
        for url, code, status, redirect, first_seen, count, pages in rows
    ]


def forget(url: str) -> None:
    with contextlib.closing(database()) as db, db:
        db.execute("DELETE FROM links WHERE url = ?", (url,))


def ignore(url: str) -> None:
    """Ignore an URL for 6 months, or until its status changes."""
    with contextlib.closing(database()) as db, db:
        db.execute("UPDATE links SET ignored = date('now') WHERE url = ?", (url,))


def replace(url: str, replacement: str) -> int:
    """Replace an URL in the content. Return the number of updated files."""
    pattern = re.compile(
        rf"(?:(?<=[\s(<])|^){re.escape(url)}(?=[\s)>\"']|$)", re.MULTILINE
    )
    files = subprocess.run(
        ["git", "grep", "-Fl", "-e", url],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    updated_files = 0
    for name in files.stdout.split():
        path = ROOT / name
        content = path.read_text(encoding="utf-8")
        updated = pattern.sub(lambda _: replacement, content)
        if updated != content:
            path.write_text(updated, encoding="utf-8")
            updated_files += 1
    return updated_files


def browse(url: str) -> None:
    subprocess.Popen(
        ["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )


class Prompt(ModalScreen[str | None]):
    """Ask for a replacement URL."""

    BINDINGS: ClassVar = [Binding("escape", "cancel", "Cancel")]
    DEFAULT_CSS = """
Prompt { align: center middle; }
Prompt Input { width: 80%; }
"""

    def __init__(self, url: str) -> None:
        super().__init__()
        self.url = url

    def compose(self) -> ComposeResult:
        yield Input(value=self.url)

    def on_input_submitted(self, event: Input.Submitted) -> None:
        value = event.value.strip()
        self.dismiss(value if value and value != self.url else None)

    def action_cancel(self) -> None:
        self.dismiss(None)


class Fixer(App[None]):
    """Review dead and redirected links."""

    TITLE = "Links"
    ENABLE_COMMAND_PALETTE = False
    CSS = """
DataTable { height: 1fr; overflow-x: hidden; scrollbar-size-vertical: 1; }
#details { height: 10; border-top: solid $primary; }
#details Static { padding: 0 1; }
"""
    BINDINGS: ClassVar = [
        Binding("b", "browse", "Browse"),
        Binding("p", "browse_page", "Browse page"),
        Binding("a", "browse_archive", "Browse archive"),
        Binding("A", "use_archive", "Use archive"),
        Binding("R", "use_redirect", "Use redirect"),
        Binding("r", "use_own", "Replace"),
        Binding("i", "ignore", "Ignore"),
        Binding("q", "quit", "Quit"),
    ]

    def __init__(self, problems: list[Problem]) -> None:
        super().__init__()
        self.problems = {problem.url: problem for problem in problems}
        self.current: Problem | None = None
        # Next sort order of each sortable column
        self.reverse: dict[str, bool] = {}

    def compose(self) -> ComposeResult:
        yield DataTable(cursor_type="row", zebra_stripes=True)
        with VerticalScroll(id="details"):
            yield Static()
        yield Footer()

    def on_mount(self) -> None:
        table = self.query_one(DataTable)
        table.add_column("Code", key="code")
        table.add_column("Status")
        table.add_column("Since", key="since")
        table.add_column("URL", key="url")
        for problem in self.problems.values():
            status = "→" if problem.redirect else problem.status
            status = re.sub(r"^Rejected status code: \d+ ", "", status)
            table.add_row(
                "" if problem.code is None else str(problem.code),
                status[:24],
                problem.first_seen or "",
                problem.url,
                key=problem.url,
            )

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        self.select(event.row_key.value)

    def on_data_table_header_selected(self, event: DataTable.HeaderSelected) -> None:
        column = event.column_key.value
        values: dict[str, Callable[[Problem], int | None]] = {
            "code": lambda problem: problem.code,
            "since": lambda problem: (
                datetime.date.fromisoformat(problem.first_seen).toordinal()
                if problem.first_seen
                else None
            ),
        }
        if column is None or column not in values:
            return
        value = values[column]
        reverse = self.reverse.get(column, False)

        def key(url: str) -> tuple[bool, int]:
            # Links without value go last
            v = value(self.problems[url])
            return (v is None) != reverse, v or 0

        table = event.data_table
        table.sort("url", key=key, reverse=reverse)
        self.reverse[column] = not reverse
        if self.current:
            table.move_cursor(row=table.get_row_index(self.current.url))

    def select(self, url: str | None) -> None:
        self.current = self.problems.get(url) if url else None
        self.show()

    def show(self) -> None:
        details = self.query_one("#details Static", Static)
        self.refresh_bindings()
        problem = self.current
        if problem is None:
            details.update("")
            return
        lines = [f"[b]URL:[/b]      {problem.url}"]
        if problem.redirect:
            lines.append(f"[b]Redirect:[/b] {problem.redirect}")
        else:
            lines.append(f"[b]Status:[/b]   {problem.status}")
            if problem.history:
                lines.append(f"[b]History:[/b]  {problem.history}")
            lines.append(f"[b]Archive:[/b]  {problem.archive}")
        for i, page in enumerate(problem.pages):
            lines.append(f"[b]{'Pages:' if i == 0 else '':9}[/b] {page}")
        details.update("\n".join(lines))

    def check_action(self, action: str, parameters: tuple[object, ...]) -> bool | None:
        problem = self.current
        if action in (
            "browse",
            "browse_archive",
            "use_archive",
            "use_own",
            "ignore",
        ):
            return problem is not None
        if action == "browse_page":
            return problem is not None and bool(problem.pages)
        if action == "use_redirect":
            return problem is not None and problem.redirect is not None
        return True

    def action_browse(self) -> None:
        assert self.current is not None
        browse(self.current.url)

    def action_browse_page(self) -> None:
        assert self.current is not None
        browse(self.current.pages[0])

    def action_browse_archive(self) -> None:
        assert self.current is not None
        browse(self.current.archive)

    def action_use_archive(self) -> None:
        assert self.current is not None
        self.use(self.current.archive)

    def action_use_redirect(self) -> None:
        assert self.current is not None and self.current.redirect is not None
        self.use(self.current.redirect)

    def action_use_own(self) -> None:
        assert self.current is not None
        problem = self.current

        def done(replacement: str | None) -> None:
            if replacement:
                self.use(replacement, problem)

        self.push_screen(Prompt(problem.redirect or problem.url), done)

    def action_ignore(self) -> None:
        assert self.current is not None
        ignore(self.current.url)
        self.remove(self.current)

    def use(self, replacement: str, problem: Problem | None = None) -> None:
        problem = problem or self.current
        assert problem is not None
        count = replace(problem.url, replacement)
        if count == 0:
            self.notify(f"{problem.url} not found in content", severity="warning")
            return
        self.notify(f"Replaced in {count} file{'s' if count > 1 else ''}")
        forget(problem.url)
        self.remove(problem)

    def remove(self, problem: Problem) -> None:
        del self.problems[problem.url]
        table = self.query_one(DataTable)
        table.remove_row(problem.url)
        if not self.problems:
            self.select(None)
            return
        row = table.coordinate_to_cell_key(table.cursor_coordinate).row_key
        self.select(row.value)


def check(local: bool) -> None:
    """Check links, then fix them."""
    base = "http://localhost:8080" if local else BASE
    DIRECTORY.mkdir(parents=True, exist_ok=True)
    INPUTS.write_text("\n".join(pages(base)) + "\n", encoding="utf-8")
    OUTPUT.unlink(missing_ok=True)
    if "GITHUB_TOKEN" not in os.environ:
        token = subprocess.run(
            ["gh", "auth", "token"], capture_output=True, text=True, check=False
        )
        if token.returncode == 0:
            os.environ["GITHUB_TOKEN"] = token.stdout.strip()
    # lychee keeps its cache in the current directory
    result = subprocess.run(
        [
            "lychee",
            "--config",
            str(ROOT / "lychee.toml"),
            "--files-from",
            str(INPUTS),
            "--format",
            "json",
            "--output",
            str(OUTPUT),
        ],
        cwd=DIRECTORY,
        check=False,
    )
    if not OUTPUT.exists():
        sys.exit(f"lychee failed with code {result.returncode}")
    record(json.loads(OUTPUT.read_text(encoding="utf-8")))
    fix()


def fix() -> None:
    """Review dead and redirected links."""
    todo = problems()
    if not todo:
        print("No dead or redirected links")
        return
    Fixer(todo).run()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("check", help="check links").add_argument(
        "--local", action="store_true", help="check http://localhost:8080"
    )
    commands.add_parser("fix", help="fix links found by the last check")
    args = parser.parse_args()
    if args.command == "check":
        check(args.local)
    else:
        fix()
