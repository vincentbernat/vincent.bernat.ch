#!/usr/bin/env nix
# -*- python -*-
#! nix shell ..#tools.image-compare --command python3
"""Compare image encodings side by side in a browser.

Each encoding is LABEL=COMMAND. In COMMAND, {in} is replaced by the source
image and {out} by the output path, without extension. Like for the website,
JPEG images are converted to sRGB with jpgicc first and images without a color
profile are tagged with the sRGB profile from $SRGB_PROFILE (set in the
development shell). For example:

    tools/image-compare /tmp/compare \\
        content/media/images/pc-cards/*@2x.jpg \\
        content/media/images/i3/rofi-drun@2x.jpg \\
        -e 'jpegli 2.0=cjpegli {in} {out}.jpg --quiet -d 2.0' \\
        -e 'AVIF 66=avifenc --codec aom --yuv 420 -q 66 -a tune=iq {in} {out}.avif' \\
        -e 'AVIF 62=avifenc --codec aom --yuv 420 -q 62 -a tune=iq {in} {out}.avif' \\
        -e 'WebP 85=cwebp -quiet -q 85 -m 6 -sharp_yuv {in} -o {out}.webp'

Then, open /tmp/compare/index.html.
"""

import argparse
import concurrent.futures
import dataclasses
import json
import os
import shlex
import shutil
import subprocess
import urllib.parse
from pathlib import Path
from typing import TypedDict

PAGE = """<!doctype html>
<meta charset="utf-8">
<title>Image comparison</title>
<style>
  body { margin: 0; font: 14px system-ui, sans-serif; background: #1b1b1b; color: #eee; }
  nav { position: sticky; top: 0; z-index: 2; padding: 8px 12px; background: #111; }
  #grid { display: grid; gap: 6px; padding: 6px;
          grid-template-columns: repeat(auto-fill, minmax(460px, 1fr)); }
  .panel { position: relative; height: 460px; overflow: hidden; background: #000; }
  .panel img { position: absolute; max-width: none; transform-origin: 0 0; }
  .panel span { position: absolute; z-index: 1; padding: 3px 8px;
                background: rgb(0 0 0 / 75%); }
</style>
<nav>
  <select id="image"></select>
  <select id="zoom">
    <option value="1">1 screen pixel</option>
    <option value="2" selected>2 screen pixels</option>
    <option value="4">4 screen pixels</option>
  </select>
  Move the mouse over a panel to pan all of them.
</nav>
<div id="grid"></div>
<script>
const data = DATA;
const image = document.getElementById("image");
const zoom = document.getElementById("zoom");
const grid = document.getElementById("grid");
let fx = 0.5, fy = 0.5;
data.forEach((d, i) => image.add(new Option(d.name, i)));

function place() {
  const scale = zoom.value / devicePixelRatio;
  for (const img of grid.querySelectorAll("img")) {
    const pw = img.parentElement.clientWidth, ph = img.parentElement.clientHeight;
    const w = img.naturalWidth * scale, h = img.naturalHeight * scale;
    const x = Math.min(0, Math.max(pw - w, pw / 2 - fx * w));
    const y = Math.min(0, Math.max(ph - h, ph / 2 - fy * h));
    img.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
    img.style.imageRendering = scale > 1 ? "pixelated" : "auto";
  }
}

function show() {
  grid.innerHTML = data[image.value].variants.map((v) => `<div class="panel">
    <span>${v.label} · ${Math.round(v.size / 1000)} kB</span><img src="${v.url}">
  </div>`).join("");
  grid.querySelectorAll("img").forEach((img) => (img.onload = place));
}

grid.addEventListener("mousemove", (e) => {
  const panel = e.target.closest(".panel");
  if (!panel) return;
  const r = panel.getBoundingClientRect();
  fx = (e.clientX - r.left) / r.width;
  fy = (e.clientY - r.top) / r.height;
  place();
});
image.addEventListener("change", show);
zoom.addEventListener("change", place);
addEventListener("resize", place);
show();
</script>
"""


@dataclasses.dataclass
class Encoding:
    label: str
    template: str

    def command(self, source: Path, output: Path) -> str:
        """Shell command to encode an image, output is without extension."""
        return self.template.replace("{in}", shlex.quote(str(source))).replace(
            "{out}", shlex.quote(str(output))
        )


class Variant(TypedDict):
    label: str
    url: str
    size: int


def encoding(spec: str) -> Encoding:
    label, sep, template = spec.partition("=")
    if not sep:
        raise argparse.ArgumentTypeError(f"missing '=' in {spec!r}")
    return Encoding(label, template)


def prepare(image: Path, directory: Path) -> Path:
    """Copy the original image into the directory. Return the image to encode."""
    shutil.rmtree(directory, ignore_errors=True)
    directory.mkdir(parents=True)
    shutil.copy(image, directory / f"original{image.suffix}")
    if image.suffix.lower() not in (".jpg", ".jpeg"):
        return image
    source = directory / "input.jpg"
    subprocess.run(["jpgicc", "-q100", image, source], check=True)
    return source


def encode(commands: list[str]) -> None:
    def run(command: str) -> None:
        subprocess.run(command, shell=True, check=True)

    with concurrent.futures.ThreadPoolExecutor() as executor:
        list(executor.map(run, commands))


def tag(files: list[Path]) -> None:
    """Tag images without a color profile with the sRGB profile."""
    # exiftool exits with 2 when all images are tagged
    result = subprocess.run(
        ["exiftool", "-q", "-overwrite_original", "-if", "not $ICC_Profile"]
        + [f"-icc_profile<={os.environ['SRGB_PROFILE']}", *files],
        check=False,
    )
    if result.returncode not in (0, 2):
        raise SystemExit(result.returncode)


def variants(
    output: Path, image: Path, directory: Path, encodings: list[Encoding]
) -> list[Variant]:
    files = [directory / f"original{image.suffix}"]
    files += [next(directory.glob(f"{i}.*")) for i in range(len(encodings))]
    labels = ["original", *(e.label for e in encodings)]
    return [
        Variant(
            label=label,
            url=urllib.parse.quote(str(f.relative_to(output))),
            size=f.stat().st_size,
        )
        for label, f in zip(labels, files, strict=True)
    ]


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("output", type=Path, help="output directory")
    parser.add_argument("images", type=Path, nargs="+", help="source images")
    parser.add_argument(
        "-e",
        dest="encodings",
        type=encoding,
        action="append",
        required=True,
        metavar="LABEL=COMMAND",
    )
    args = parser.parse_args()
    output: Path = args.output
    images: list[Path] = args.images
    encodings: list[Encoding] = args.encodings
    directories = [output / f"{i}-{image.stem}" for i, image in enumerate(images)]

    commands = []
    for image, directory in zip(images, directories, strict=True):
        source = prepare(image, directory)
        commands += [
            e.command(source, directory / str(i)) for i, e in enumerate(encodings)
        ]
    encode(commands)
    # AVIF images are always tagged
    tag([f for d in directories for f in d.iterdir() if f.suffix != ".avif"])

    data = [
        {"name": str(image), "variants": variants(output, image, directory, encodings)}
        for image, directory in zip(images, directories, strict=True)
    ]
    (output / "index.html").write_text(PAGE.replace("DATA", json.dumps(data)))


if __name__ == "__main__":
    main()
