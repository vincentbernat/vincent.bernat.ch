{# nginx configuration to be included at the "server" level #}
{% macro domain(url) -%}
  {{ url.split("://")[- 1].split("/")[0] }}
{%- endmacro %}
{% macro csp(extra={}) %}
{% set directives = {
  "default-src":     "'self' blob:",
  "script-src":      "blob: " + domain(media_url('js/')) + " 'sha256-AN5MljpALMzWNoPcfUugXonRm0INnyCCCqVRwMlp22A='",
  "style-src":       "'unsafe-inline' data: " + domain(media_url('css/')),
  "font-src":        "data: " + domain(media_url('fonts/')),
  "img-src":         "data: " + domain(media_url('images/')),
  "object-src":      domain(media_url('images/')) + " " + domain(media_url('files/')),
  "frame-src":       domain(media_url('images/')) + " " + domain(media_url('files/')),
  "worker-src":      "blob:",
  "media-src":       "blob: about: " + domain(media_url('videos/')) + " " + domain(media_url('images/')),
  "connect-src":     "comments.luffy.cx " + domain(media_url('videos/')),
  "base-uri":        "'none'",
  "frame-ancestors": "http:",
  "form-action":     "'self'",
} %}
{% for name, value in directives.items() %}
{{ "{:15}".format(name) }} {{ value }}{% if extra[name] is defined %} {{ extra[name] }}{% endif %};
{% endfor %}
{% endmacro %}
{% macro add_headers(extra={}) %}
{% set headers = {
  "X-Content-Type-Options": "nosniff",
  "Strict-Transport-Security": "max-age=31536000",
  "Content-Security-Policy": csp()|striptags,
} %}
{% do headers.update(extra) %}
{% for name, value in headers.items() %}
add_header "{{ name }}" "{{ value }}";
{% endfor %}
{% endmacro %}

index      index.html;
error_page 404 {{ content_url('/en/404.html') }};
expires    6h;
{{ add_headers() }}

location = /nginx.conf {
  return 404;
}

{# language selection #}
{% for code, lang in languages %}
location /{{ code }} {
  error_page 404 {{ content_url('/' + code + '/404.html') }};
  try_files $uri.html $uri $uri/index.html =404;
}
location {{ content_url('/' + code + '/404.html') }} {
  internal;
  try_files $uri.html $uri;
}
{% endfor %}
location = / {
  access_log off;
  log_not_found off;
  set_from_accept_language $lang {% for code, lang in languages %}{{ code }}{% if not loop.last %} {% endif %}{% endfor %};
  {{ add_headers({"Vary": "Accept-Language"})|indent(2) }}
  return 301  /$lang;
}

location / {
  try_files $uri.html $uri $uri/index.html =404;
}

{# redirections #}
location = /favicon.ico {
  access_log off;
  return 301 {{ media_url('images/favicon.png') }};
}
location = /favicon.png {
  access_log off;
  return 301 {{ media_url('images/favicon.png') }};
}
location = /apple-touch-icon.png {
  access_log off;
  return 301 {{ media_url('images/favicon.png') }};
}
location ~ ^/apple-touch-icon-\d+x\d+.png$ {
  access_log off;
  return 301 {{ media_url('images/favicon.png') }};
}
location = /apple-touch-icon-precomposed.png {
  access_log off;
  log_not_found off;
  return 404;
}
location ~ ^(?<canonical>.+)/(?:index\.html)?$ {
  access_log off;
  log_not_found off;
  return 301 $canonical;
}
location ~ ^(?<canonical>.*)\.html$ {
  access_log off;
  log_not_found off;
  return 301 $canonical;
}

{% for res in resource.node.walk_resources() %}
{# handle exceptions #}
{% set specific %}
{% if res.meta.nolog %}
  access_log off;
  log_not_found off;
{% endif %}
{% if res.meta.mime %}
  types { }
  default_type {{ res.meta.mime }};
{% endif %}
{% set extra_headers = res.meta.headers|default({}) %}
{% if res.meta.csp %}
{% do extra_headers.update({"Content-Security-Policy": csp(res.meta.csp)|striptags}) %}
{% endif %}
{% if extra_headers %}
  {{ add_headers(extra_headers)|indent(2) }}
{% endif %}
{% endset %}
{% if specific %}
location = {{ content_url(res.url) }} {
{{ specific }}
  try_files $uri.html $uri $uri/index.html =404;
}
{% endif %}
{% endfor %}

{# Misc #}
location /ip {
  default_type text/plain;
  expires epoch;
  return 200 $remote_addr;
}
location /redirect-ddg {
  return 302 https://html.duckduckgo.com/html?q=site:{{base|replace("https://","")}}/$arg_lang+$arg_q;
}
