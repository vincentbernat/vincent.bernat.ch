{# nginx configuration to be included at the "server" level #}
{% macro domain(url) -%}
  {{ url.split("://")[- 1].split("/")[0] or "'self'" }}
{%- endmacro %}
{% macro csp(extra={}) %}
{% set directives = {
  "default-src":     "'self' blob:",
  "script-src":      "blob: " + domain(media_url('js/')) + " 'sha256-k0b7LgV8ZkLI+Nfd9gfqq0b9OtkxP/wr23+WxOBIb30='",
  "style-src":       "'unsafe-inline' data: " + domain(media_url('css/')),
  "font-src":        "data: " + domain(media_url('fonts/')),
  "img-src":         "'self' data: " + domain(media_url('images/')),
  "object-src":      domain(media_url('images/')) + " " + domain(media_url('files/')),
  "frame-src":       domain(media_url('images/')) + " " + domain(media_url('files/')),
  "worker-src":      "blob:",
  "media-src":       "blob: data: " + domain(media_url('videos/')) + " " + domain(media_url('images/')),
  "connect-src":     "'self' comments.luffy.cx " + domain(media_url('videos/')),
  "base-uri":        "'none'",
  "frame-ancestors": "https:",
  "form-action":     "'self'",
} %}
{% for name, value in directives.items() %}
{{ "{:15}".format(name) }} {{ value }}{% if extra[name] is defined %} {{ extra[name] }}{% endif %};
{% endfor %}
{% endmacro %}
{% macro serve(files="$uri.html $uri $uri/index.html =404") %}
{%- if site.config.mode == "production" -%}
try_files {{ files }};
{%- else -%}
proxy_pass http://hyde;
{%- endif -%}
{% endmacro %}
{% macro add_headers(extra={}) %}
{% set headers = {
  "X-Content-Type-Options": "nosniff",
  "Strict-Transport-Security": "max-age=31536000",
  "Content-Security-Policy": csp()|striptags,
} %}
{% do headers.update(extra) %}
{% for name, value in headers.items() %}
add_header "{{ name }}" "{{ value }}";
{% endfor %}
{% endmacro %}

{% set server %}
index      index.html;
error_page 404 {{ content_url('/en/404.html') }};
expires    {% if site.config.mode == "production" %}6h{% else %}epoch{% endif %};
{{ add_headers() }}

location = /nginx.conf {
  return 404;
}

{# language selection #}
{% for code, lang in languages %}
location /{{ code }} {
  error_page 404 {{ content_url('/' + code + '/404.html') }};
  {{ serve() }}
}
location = /{{ code }}/blog/subscribe {
  return 301 /{{ code }}/blog/atom.xml;
}
location {{ content_url('/' + code + '/404.html') }} {
  internal;
  {{ serve("$uri.html $uri") }}
}
{% endfor %}
location = / {
  access_log off;
  log_not_found off;
{% if site.config.mode == "production" %}
  set_from_accept_language $lang {% for code, lang in languages %}{{ code }}{% if not loop.last %} {% endif %}{% endfor %};
  {{ add_headers({"Vary": "Accept-Language"})|indent(2) }}
  return 301 /$lang;
{% else %}
  autoindex on;
{% endif %}
}

location / {
  {{ serve() }}
}

{# redirections #}
location = /favicon.ico {
  access_log off;
  log_not_found off;
  return 404;
}
location ~ ^/apple-touch-icon(-\d+x\d+|precomposed|).png {
  access_log off;
  log_not_found off;
  return 404;
}
location ~ ^(?<canonical>.+)/(?:index\.html)?$ {
  access_log off;
  return 301 $canonical;
}
{# in development, URLs keep their .html extension #}
{% if site.config.mode == "production" %}
location ~ ^(?<canonical>.*)\.html$ {
  access_log off;
  return 301 $canonical;
}
{% endif %}

{% for res in resource.node.walk_resources() %}
{# handle exceptions #}
{% set specific %}
{% if res.meta.nolog %}
  access_log off;
  log_not_found off;
{% endif %}
{% if res.meta.mime %}
  types { }
  default_type {{ res.meta.mime }};
{% endif %}
{% set extra_headers = res.meta.headers|default({}) %}
{% if res.meta.csp %}
{% do extra_headers.update({"Content-Security-Policy": csp(res.meta.csp)|striptags}) %}
{% endif %}
{% if extra_headers %}
  {{ add_headers(extra_headers)|indent(2) }}
{% endif %}
{% endset %}
{% if specific %}
location = {{ content_url(res.url) }} {
{{ specific }}
  {{ serve() }}
}
{% endif %}
{% endfor %}

{# Misc #}
location /ip {
  default_type text/plain;
  expires epoch;
  return 200 $remote_addr;
}
location = /hit {
{% if site.config.mode == "production" %}
  access_log off;
  proxy_pass http://127.0.0.3:8087/count;
  proxy_pass_request_headers off;
  proxy_set_header Accept-Language $http_accept_language;
  proxy_set_header User-Agent $http_user_agent;
  proxy_set_header X-Real-Ip $remote_addr;
{% else %}
  return 204;
{% endif %}
}
location /redirect-ddg {
  return 302 https://html.duckduckgo.com/html?q=site:{{base|replace("https://","")}}/$arg_lang+$arg_q;
}
{% endset %}

{%- if site.config.mode == "production" %}
{{ server }}
{% else %}
{# complete configuration, to be run with "nginx -p <dir> -c <dir>/nginx.conf" #}
daemon off;
pid nginx.pid;
events {}
http {
{# keep only the time of day #}
  map $time_local $time_short {
    ~^[^:]+:(\S+) $1;
  }
  log_format short '$time_short $status "$request_method $request_uri"';
  access_log /dev/stdout short;
  client_body_temp_path client-body;
  proxy_temp_path proxy;
  proxy_intercept_errors on;
  proxy_read_timeout 10m;

  upstream hyde {
    server 127.0.0.1:8081;
  }

  server {
    listen 127.0.0.1:8080;
    listen [::1]:8080;
    root {{ site.config.deploy_root_path }};

{# videos come from the disk, or from the media server when missing #}
    location ~ ^/media/videos/[^/]+/ {
      root {{ site.config.content_root_path }};
      try_files $uri @media;
    }

    location @media {
      rewrite ^/media/(.*)$ /$1 break;
      proxy_pass https://media.bernat.ch;
      proxy_ssl_server_name on;
    }

{{ server|indent(4, true) }}
  }
}
{% endif %}
