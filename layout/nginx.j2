{# nginx configuration to be included at the "server" level #}
{% from "macros.j2" import csp with context %}
{% macro serve(files="$uri.html $uri $uri/index.html =404") %}
try_files {{ files }};
{%- endmacro %}
{% macro add_headers(extra={}) %}
{% set headers = {
  "X-Content-Type-Options": "nosniff",
  "Strict-Transport-Security": "max-age=31536000",
  "Content-Security-Policy": csp()|striptags,
} %}
{% do headers.update(extra) %}
{% for name, value in headers.items() %}
add_header "{{ name }}" "{{ value }}";
{% endfor %}
{% endmacro %}

index      index.html;
error_page 404 {{ content_url('/en/404.html') }};
expires    1h;
absolute_redirect off;
{{ add_headers() }}

location = /nginx.conf {
  return 404;
}
location = /Caddyfile {
  return 404;
}

{# language selection #}
{% for code in languages %}
location /{{ code }} {
  error_page 404 {{ content_url('/' + code + '/404.html') }};
  {{ serve() }}
}
location = /{{ code }}/blog/subscribe {
  return 301 /{{ code }}/blog/atom.xml;
}
location {{ content_url('/' + code + '/404.html') }} {
  internal;
  {{ serve("$uri.html $uri") }}
}
{% endfor %}
location = / {
  access_log off;
  log_not_found off;
  set $lang {{ languages|first }};
  if ($http_accept_language ~ "(?:^|,)\s*({{ languages|join("|") }})\b") {
    set $lang $1;
  }
  {{ add_headers({"Vary": "Accept-Language"})|indent(2) }}
  return 301 /$lang;
}

location / {
  {{ serve() }}
}

{# redirections #}
location = /favicon.ico {
  access_log off;
  log_not_found off;
  return 404;
}
location ~ ^/apple-touch-icon(-\d+x\d+|precomposed|).png {
  access_log off;
  log_not_found off;
  return 404;
}
location ~ ^(?<canonical>.+)/(?:index\.html)?$ {
  access_log off;
  return 301 $canonical;
}
location ~ ^(?<canonical>.*)\.html$ {
  access_log off;
  return 301 $canonical;
}

{% for res in resource.node.all_resources() %}
{# handle exceptions #}
{% set specific %}
{% if res.meta.nolog %}
  access_log off;
  log_not_found off;
{% endif %}
{% if res.meta.mime %}
  types { }
  default_type {{ res.meta.mime }};
{% endif %}
{% set extra_headers = dict(res.meta.headers or {}) %}
{% if res.meta.csp %}
{% do extra_headers.update({"Content-Security-Policy": csp(res.meta.csp)|striptags}) %}
{% endif %}
{% if extra_headers %}
  {{ add_headers(extra_headers)|indent(2) }}
{% endif %}
{% endset %}
{% if specific %}
location = {{ content_url(res.url) }} {
{{ specific }}
  {{ serve() }}
}
{% endif %}
{% if res.meta.alias %}
location = {{ res.meta.alias }} {
  return 301 {{ content_url(res.url) }};
}
{% endif %}
{% endfor %}

{# Misc #}
location /ip {
  default_type text/plain;
  expires epoch;
  return 200 $remote_addr;
}
location = /hit {
  access_log off;
  proxy_pass http://127.0.0.3:8087/count;
  proxy_pass_request_headers off;
  proxy_set_header Accept-Language $http_accept_language;
  proxy_set_header User-Agent $http_user_agent;
  proxy_set_header X-Real-Ip $remote_addr;
}
location /redirect-ddg {
  return 302 https://html.duckduckgo.com/html?q=site:{{base|replace("https://","")}}/$arg_lang+$arg_q;
}
