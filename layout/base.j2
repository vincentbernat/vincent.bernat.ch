{# -*- web -*- #}
{%- set formatted_article -%}
{%- filter markdown|typogrify -%}
{% block article -%}{%- endblock %}
{%- endfilter -%}
{%- endset -%}
<!doctype html>
<html lang="{{ resource.meta.language }}" class="nojs">
<head>
  <meta charset="utf-8">
{% macro preload_font(name) %}
<link rel="preload" href="{{ media_url('fonts/{}.woff2'.format(name)) }}" as="font" type="font/woff2">
{%- endmacro %}
  {{ preload_font('merriweather') }}
  {{ preload_font('merriweather-italic') }}
{% if '</code>' in formatted_article or '</pre>' in formatted_article %}
  {{ preload_font('iosevka-custom-regular') }}
{% endif %}
  <link rel="stylesheet" href="{{ media_url('css/luffy.css') }}">
{% for css in resource.meta.css %}
  <link rel="stylesheet" href="{{ media_url('css/' + css) }}">
{% endfor %}
  <title>{{ resource.meta.title|e }}</title>
{% if resource.meta.author %}
  <meta name="author" data-pagefind-meta="author[content]" content="{{ resource.meta.author|e }}">
{% endif %}
  <meta name="viewport" content="width=device-width,initial-scale=1">
{% if resource.meta.noindex %}
  <meta name="robots" content="noindex,follow">
{% endif %}
{% if resource.meta.mastodon %}
  <meta property="fediverse:creator" content="{{ resource.meta.mastodon }}">
{% endif %}
  <meta property="og:type" content="article">
  <meta property="og:locale" content="{{ resource.meta.locale }}">
  <meta property="og:title" content="{{ resource.meta.title|e }}">
  <meta property="og:description" name="description" content="
{%- filter replace('\n', ' ')|truncate(150)|trim()|e %}
{%- if resource.meta.description %}{{ resource.meta.description }}
{%- else %}{{ formatted_article|truncate(1000)|striptags }}
{%- endif %}
{%- endfilter %}">
  <meta property="og:image" content="{{ media_url(resource.cover_image()) }}">
{% if resource.meta.created != None %}
  <meta property="article:published_time" data-pagefind-meta="date[content]" content="{{ resource.meta.created|xmldatetime }}">
{% if resource.meta.modified != None and resource.meta.modified != resource.meta.created %}
  <meta property="article:modified_time" content="{{ resource.meta.modified|xmldatetime }}">
{% endif %}
{% endif %}
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="{{ media_url('images/favicon.png') }}" sizes="64x64">
  <link rel="icon" href="{{ media_url('images/favicon.svg') }}" type="image/svg+xml">
  <link rel="canonical" href="{{base}}{{ content_url(resource.url) }}">
{% if resource.translations %}
{% for translation in resource.translations %}
  <link rel="alternate" hreflang="{{ translation.meta.language }}" href="{{ base }}{{ content_url(translation.url) }}">
{% endfor %}
{% endif %}
  <link rel="alternate" href="{{ content_url( resource.meta.language + '/blog/atom.xml') }}" type="application/atom+xml" title="ATOM feed">
  <script type="module">document.documentElement.classList.remove("nojs");</script>
</head>
<body>
  <main class="lf-main">
    <article{% if not resource.meta.noindex and resource.name != "index.html" %} data-pagefind-body{% endif %}>
{% if not resource.meta.notitle %}
      <header>
        <h1>{{resource.meta.title.split("|")[0]|typogrify}}</h1>
{% from "macros.j2" import resource_date with context %}
        <h2 data-pagefind-ignore>
          {{  resource.meta.author|default("", true)|e }}
          {{ resource_date(resource.meta.language, resource) | indent(18) }}
        </h2>
        {% filter indent(8) %}{% include "also.j2" %}{% endfilter %}
      </header>
{% endif %}
      <div class="lf-text">

{% mark article %}{{ formatted_article }}{% endmark %}

      </div>
    </article>
  </main>

  {# Navigation bar #}
  <nav id="lf-navbar">
    {% filter indent(4) %}{% include "menu.j2" %}{% endfilter %}
{% if resource.name != "search.html" %}
    <form id="lf-search" action="/redirect-ddg" data-action="{{ content_url(resource.meta.language + '/search.html') }}" role="search">
      <input type="hidden" name="lang" value="{{ resource.meta.language }}">
      <input type="submit" value="" aria-label="{{ resource.meta.l10n.search|e }}">
      <input id="lf-search-query" type="text" name="q" value="" autocomplete="off" aria-label="{{ resource.meta.l10n.search|e }}">
    </form>
{% endif %}
  </nav>

  <footer>
  {% filter indent(2) %}{% include "footer.j2" %}{% endfilter %}

  </footer>

  <div class="lf-main">
    {% filter indent(4) %}{% include "links.j2" %}{% endfilter %}
{% if resource.meta.comments %}
    <div id="isso-thread" class="when-js" aria-live="polite"
         data-title="{{ resource.meta.title|e }}"
         data-isso-id="/{{ resource.relative_path[:-5] }}"></div>
    </div>
{% endif %}
  </div>
  <div class="lf-backtotop"><a href="#" aria-label="Back to top"></a></div>

{# Load remaining scripts #}
{% if resource.meta.comments %}
  <link rel="stylesheet" data-href="{{ media_url('css/isso.css') }}" href="data:text/css;base64," data-name="isso.css">
  <script data-src="{{ media_url('js/isso.js') }}" data-name="isso.js"
          data-isso="https://comments.luffy.cx/"
          data-isso-lang="{{ resource.meta.language }}"
          data-isso-css-url="data:text/css;base64,"></script>
{% endif %}
  <script src="{{ media_url('js/luffy.js') }}" type="module"></script>
{% for js in resource.meta.js %}
  <script src="{{ media_url('js/' + js) }}" data-name="{{ js }}" type="module"></script>
{% endfor %}
</body>
</html>
