{# -*- web -*- #}

{% macro format_resource(ctx, resource) -%}
<li{% if resource.tags and "outdated" in resource.tags|map('string') %} class="lf-outdated"{% endif %}>
  <a href="{{ content_url(resource.url) }}" {% if ctx.meta.language != resource.meta.language -%}
 lang="{{ resource.meta.language }}" hreflang="{{ resource.meta.language }}"
{%- endif %} class="lf-title">{{ resource.meta.title|e }}</a>
{% if ctx.meta.language != resource.meta.language %}
 ({{ ctx.meta.l10n.language[resource.meta.language] }})
{% endif %}
  {{ resource_short_date(ctx.meta.language, resource) | indent(2) }}
</li>
{%- endmacro %}

{# List blog posts pertaining to a given language #}
{% macro list_posts(lang, start=0, end=None) %}
<ul class="lf-list-titles">
{% set ctx = resource %}
{%- for resource in (site.sorted("time")|in_language(lang))[start:end] %}
  {{ format_resource(ctx, resource)|indent(2) }}
{% endfor %}
</ul>
{% endmacro %}

{# Inline list of articles, quoted as expected for the current language #}
{% macro list_articles(articles) %}
{%- set lang = resource.meta.language -%}
{%- for article in articles -%}
{%- set title = article.meta.title|replace("“", "‘")|replace("”", "’")|e -%}
{%- set link = "[" ~ title ~ "](" ~ content_url(article.url) ~ "){ .lf-title }" -%}
{%- if lang == "fr" -%}
« {{ link }} »{{ "." if loop.last else (" et " if loop.revindex == 2 else ", ") }}
{%- else -%}
“{{ link }}{{ "." if loop.last else "," }}”{{ "" if loop.last else (" and " if loop.revindex == 2 else " ") }}
{%- endif -%}
{%- endfor -%}
{% endmacro %}

{% macro tagfmt_plain(resource, tag, text, disabled) %}
{{ text[0]|upper }}{{ text[1:] }}
{% endmacro %}
{% macro tagfmt_link(resource, tag, text, disabled) %}
{%- if tag != "outdated" and not disabled %}<a href="{{ content_url(resource.meta.language + '/blog') }}#tag-{{ tag }}">{% endif -%}
{{- text -}}
{%- if tag != "outdated" and not disabled %}</a>{% endif %}
{% endmacro %}

{# fmt is a function taking the subtag name as first argument and description as second argument. #}
{% macro format_tag(resource, tag, fmt) %}
{%- set tag = tag|string %}
{%- set subtags = tag.split("-") %}
{%- filter replace("\n", "") %}
{%- for subtag in subtags -%}
    {%- set subtag = subtags[:loop.index]|join('-') -%}
    {{- fmt(resource, subtag,
            site.tags[subtag]|attr("descr_" + resource.meta.language)|e ~
            site.tags[subtag].descr|e, site.tags[subtag].hidden) -}}
    {%- if not loop.last %} > {% endif -%}
{%- endfor -%}
{%- endfilter -%}
{% endmacro %}

{# URL of the Atom feed of a category, empty if none #}
{% macro tag_feed(lang, tag) -%}
{%- set feed = site.resource(lang ~ "/blog/atom-" ~ tag ~ ".xml") -%}
{%- if feed %}{{ content_url(feed.url) }}{% endif -%}
{%- endmacro %}

{# Display all the categories #}
{% macro list_tags(lang) %}
{% set ctx = resource %}
{% set tags = [] %}
{% for tag, info in site.tags.items() if not info.hidden %}
{% do tags.append(tag) %}
{% endfor %}
<div class="toc"><ul>
{%- for tag, subtags in tags|reject("equalto", "outdated")|tag_tree %}
<li><a href="#tag-{{tag}}">{{ format_tag(resource, tag, tagfmt_plain) }}</a>
{%- if subtags %}<ul>
{%- for subtag in subtags -%}
<li><a href="#tag-{{subtag}}">{{ format_tag(resource, subtag, tagfmt_plain).split(" > ", 1)[1] }}</a>
{%- endfor -%}
</ul>{% endif %}
{%- endfor -%}
</ul></div>
<div class="lf-list-tags">
{% for tag in tags %}
{% set rr = site.sorted("time")|in_language(lang)|tagged(tag) %}
{% if rr and tag|string != "outdated" %}
  <div class="lf-tag" id="tag-{{tag}}">
{% set feed = tag_feed(lang, tag|string) %}
    <h2>{{ format_tag(resource, tag|string, tagfmt_plain) }}
{%- if feed %} <a href="{{ feed }}" class="lf-feed"><img src="{{ media_url('images/l/rss.svg') }}" alt="{{ ctx.meta.l10n.feed|e }}" title="{{ ctx.meta.l10n.feed|e }}"></a>{% endif -%}
    </h2>
    <ul class="lf-list-titles">
{% for resource in rr %}
      {{ format_resource(ctx, resource)|indent(6) }}
{% endfor %}
    </ul>
  </div>
{% endif %}
{% endfor %}
</div>

{% endmacro %}

{# Display date of the resource #}
{% macro resource_date(lang, resource) %}
{% if resource.meta.created != None %}
<time datetime="{{ resource.meta.created|xmldatetime }}">
    {{ resource.meta.created|human_date(lang, 'long') }}
</time>
{%- endif %}
{% endmacro %}
{% macro resource_short_date(lang, resource) %}
{% if resource.meta.created != None %}
<time datetime="{{ resource.meta.created|xmldatetime }}"
      title="{{ resource.meta.created|human_date(lang, 'long')|striptags }}">
  {{ resource.meta.created|human_date(lang) }}
</time>
{%- endif %}
{% endmacro %}

{# Emoji summarizing AI usage for the resource #}
{% macro ai_usage_emoji(resource, usage=None) -%}
{%- set entry = usage or resource.meta['ai-usage'] or resource.meta.l10n.noai -%}
{%- if entry != "disabled" -%}
<button class="lf-ai-usage" aria-label="{{ entry|e }}">{{ entry|ai_usage_emoji(resource.meta.ai_usage) }}</button>
{%- endif -%}
{%- endmacro %}

{# Display a photo gallery, described in the galleries metadata #}
{% macro gallery(index) %}
{% set directory = resource.meta.galleries[index].directory %}
{% set description = resource.meta.galleries[index].description %}
<div class="lf-gallery">
{% for image in site.node("media/images/" + directory).sorted("name")
   if image.kind in ("jpg","png") %}
{% set thumb = thumbnail(image) %}
<a href="{{ media_url(image.path[6:]) }}"><img src="{{ media_url(thumb.path[6:]) }}" height="{{ thumb.height }}" width="{{ thumb.width }}" alt="{{ description|e }}" class="lf-thumbnail"></a>
{% endfor %}
</div>
{% endmacro %}

{% macro listing(directory, nb=0) %}
<ul class="lf-listing">

{% for archive in site.node("media/" + directory).sorted("name")|natural_sort %}
{% if nb < 0 and loop.revindex <= -nb or nb > 0 and loop.index <= nb %}
<li>
  <img class="lf-filetype"
       src="{{ media_url("images/l/ext--" + archive.kind + ".svg") }}"
       alt="{{ "[" + archive.kind + "]" }}">
  <a href="{{ media_url(archive.path[6:]) }}">{{ archive.name }}</a>
</li>
{% endif %}
{% endfor %}
</ul>
{% endmacro %}

{# Articles of the RSS feed, with links used by the introduction #}
{% macro rss_articles() %}
{% set feed = base ~ "/" ~ resource.meta.language ~ "/blog/atom.xml" %}
[rss]: {{ feed }}
[FeedRabbit]: https://feedrabbit.com/?url={{ feed|urlencode }}
[Blogtrottr]: https://blogtrottr.com/?subscribe={{ feed|urlencode }}
[Miniflux]: https://miniflux.app/ "Miniflux"
[NewsBlur]: https://www.newsblur.com/?url={{ feed|urlencode }} "NewsBlur"
[Bluesky]: https://bsky.app/profile/{{ resource.meta.bluesky }}
[Mastodon]: {{ resource.meta.mastodon|mastodon_href }}
[blog]: {{ content_url(resource.meta.language ~ "/blog") }}

{% for res in resource.node.sorted("time_" + resource.meta.language)|top(6) %}
<article>
  <header>
    <h1><a href="{{ content_url(res.url) }}">{{ res.meta.title|e }}</a></h1>
    <h2>
      {{ res.meta.author|e }}
      {{ resource_date(resource.meta.language, res)|indent(6) }}
    </h2>
  </header>
  <div class="lf-text">
{{ article(res)|clean_rss }}
  </div>
</article>

{% endfor %}
{% endmacro %}

{# Licenses of the files of this site #}
{% macro license_list() %}
{% for paths, items in licenses(resource.meta.language) %}
 - {% for path in paths %}`{{ path }}`{% if not loop.last %}, {% endif %}{% endfor %}: {{ items|join(", ") }}
{% endfor %}
{% endmacro %}

{# Content-Security-Policy header, for the web server configuration #}
{% macro domain(url) -%}
  {{ url.split("://")[- 1].split("/")[0] or "'self'" }}
{%- endmacro %}
{% set nojs_script = 'if ("noModule" in HTMLScriptElement.prototype) document.documentElement.classList.remove("nojs");' %}
{% set reload_script = 'new EventSource("/_reload").onmessage = () => location.reload();' %}
{% macro csp(extra={}) %}
{% set directives = {
  "default-src":     "'self' blob:",
  "script-src":      "blob: " + domain(media_url('js/')) + " " + nojs_script|csp_hash
                     + ("" if site.mode.production else " " + reload_script|csp_hash),
  "style-src":       "'unsafe-inline' data: " + domain(media_url('css/')),
  "font-src":        "data: " + domain(media_url('fonts/')),
  "img-src":         "'self' data: " + domain(media_url('images/')),
  "object-src":      domain(media_url('images/')) + " " + domain(media_url('files/')),
  "frame-src":       domain(media_url('images/')) + " " + domain(media_url('files/')),
  "worker-src":      "blob:",
  "media-src":       "blob: data: " + domain(media_url('videos/')) + " " + domain(media_url('images/')),
  "connect-src":     "'self' comments.luffy.cx " + domain(media_url('videos/')),
  "base-uri":        "'none'",
  "frame-ancestors": "'self' https:",
  "form-action":     "'self'",
} %}
{% for name, value in directives.items() %}
{{ "{:15}".format(name) }} {{ value }}{% if extra[name] is defined %} {{ extra[name] }}{% endif %};
{% endfor %}
{% endmacro %}
